# dependencies
node_modules

# build output
dist
dist.zip
dist-ssr
*.local

# typescript composite build artifacts (from `tsc -b`)
*.tsbuildinfo
/vite.config.js
/vite.config.d.ts

# capacitor native shells: `ios/` and `android/` ARE committed (they hold
# signing config, icons and Info.plist), but everything generated inside them
# is not — `cap sync` rebuilds all of it from dist/.
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/App/Podfile.lock
/android/app/src/main/assets/public/
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# env
.env
.env.*
!.env.example

# service-account credentials — never commit these
*service-account*.json
google-tts-service-account.json

# vo:build batch job state (transient; resumes polling if a run is stopped)
src/vo/clips/.vo-batch.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# vo:build takes thrown out by the length gate (kept for listening, never shipped)
src/vo/clips/.rejects/
