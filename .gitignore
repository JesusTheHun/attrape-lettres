# dependencies
node_modules

# build output
dist
dist.zip
dist-ssr
*.local

# typescript composite build artifacts (from `tsc -b`)
*.tsbuildinfo
/apps/game-web/vite.config.js
/apps/game-web/vite.config.d.ts

# editor / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# env
.env
.env.*
!.env.example

# service-account credentials — never commit these
*service-account*.json
google-tts-service-account.json

# vo:build batch job state (transient; resumes polling if a run is stopped)
apps/game-web/src/vo/clips/.vo-batch.json

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# vo:build takes thrown out by the length gate (kept for listening, never shipped)
apps/game-web/src/vo/clips/.rejects/

# a hand-taken snapshot of the clip bank, from before a re-bake. Ignored rather
# than deleted: git holds every take that was ever committed, but a snapshot can
# also hold one that was replaced before it ever reached a commit.
clips.bak/

# companion design proposals — the screenshot-QA pages written while a new mascot
# is being designed. Nothing ships from here; see the new-companion skill.
apps/game-web/src/dev/proposals/

# AI
.claude/*
!.claude/skills/
.claude/skills/*-workspace/