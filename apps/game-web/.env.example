# Copy to `.env.local`. Every one of these is OPTIONAL: unset means the feature
# is inert, and the app runs exactly as it always has — fully offline, no
# network calls at all. That is the default for `vite dev` and for the PWA.

# First-party analytics + JS error reports (src/telemetry.ts).
# Our own server, never a third party — Kids Category guideline 1.3.
# Analytics is consent-gated; error reports carry no identifier and are not.
VITE_TELEMETRY_URL=

# Household sync (src/sync/client.ts). Holds opaque ids and integers only:
# children's names never leave the device.
VITE_SYNC_URL=
