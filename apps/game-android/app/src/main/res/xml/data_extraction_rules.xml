<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) Auto Backup and device-to-device transfer rules. The
  API 30- twin is xml/backup_rules.xml; the reasoning lives there in full and
  the two files must stay in step.

  Both sections exclude the device id for the same reason: a counter key must
  belong to exactly one live device, or max() merges two devices' progress as
  one and a child loses stars (invariant 9). Device transfer is excluded too —
  "the old phone is retired" is the usual case, not a guarantee.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="fr.dappit.attrapelettres.device.xml" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="fr.dappit.attrapelettres.device.xml" />
    </device-transfer>
</data-extraction-rules>
