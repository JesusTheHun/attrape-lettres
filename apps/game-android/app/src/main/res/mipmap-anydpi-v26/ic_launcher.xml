<?xml version="1.0" encoding="utf-8"?>
<!--
  minSdk is 26, so this IS the launcher icon: there are no legacy PNG buckets
  under it and none are needed. All three layers are vectors, which is what
  keeps the Android 12+ splash screen — it blows the icon up to ~160 dp — sharp.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
