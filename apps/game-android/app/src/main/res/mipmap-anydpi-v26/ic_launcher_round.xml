<?xml version="1.0" encoding="utf-8"?>
<!--
  `android:roundIcon`, for the launchers that ask for it. Same three layers: the
  round-vs-square choice is the MASK's, and the mask is the system's, so a
  second composition here would only be a second thing to keep in step.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
