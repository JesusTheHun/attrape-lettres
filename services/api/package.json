{
  "name": "@attrape/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Household sync + first-party telemetry. The only server this product has.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "DYNAMO_ENDPOINT=http://localhost:8123 vitest run",
    "dynamo:local": "docker run -d --rm --name attrape-ddb -p 8123:8000 amazon/dynamodb-local",
    "bundle": "node scripts/bundle.mjs",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1099.0",
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/lib-dynamodb": "^3.1099.0",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
